{
  "owner": "Rin0107",
  "main_checkout": "~/src/okuos/repos/ideas",
  "apps_dir": "~/src/wakuwaku",
  "runtime_dir": "~/.local/state/wakuwaku",
  "ideas_dir": "ideas_wakuwaku",

  "ticks_per_day": 6,
  "max_ticks_mvp": 30,
  "max_ticks_iteration": 15,
  "max_iterations": 2,
  "max_attempts_per_issue": 3,
  "max_open_issues": 8,
  "lock_ttl_minutes": 150,
  "max_consecutive_failures": 3,

  "intake_every_days": 7,
  "retro_every_days": 7,
  "min_untried_ideas": 30,

  "select": {
    "candidates": 15,
    "min_free": 3,
    "min_light": 3
  },
  "evaluate": {
    "ship_min_wakuwaku": 4,
    "ship_min_quality": 3
  },

  "allowed_services": ["github", "cloudflare-free", "github-releases"],
  "deny_packages": ["@supabase/supabase-js", "firebase", "@sentry/browser", "posthog-js", "mixpanel-browser", "@vercel/analytics", "openai", "@anthropic-ai/sdk", "@google/generative-ai", "stripe", "@aws-sdk/client-bedrock-runtime"],
  "protected_paths": [
    "factory.json",
    ".claude/",
    "cmd/",
    "internal/",
    "go.mod",
    "harness/TICK.md",
    "harness/rubric.md",
    ".github/workflows/",
    "docs/DESIGN.md",
    "harness/reviewer.md",
    "templates/web/.github/",
    "templates/web/scripts/",
    "templates/web/src/worker/security.ts",
    "templates/web/wk.json",
    "templates/go-cli/scripts/",
    "templates/go-cli/wk.json",
    "templates/go-cli/.github/",
    "templates/site/",
    "templates/web/vitest.config.ts",
    "templates/web/stryker.config.json",
    "templates/web/spec/README.md",
    "templates/go-cli/Makefile",
    "templates/go-cli/spec/README.md",
    "docs/TESTING.md",
    "scripts/",
    "spec/",
    "templates/web/playwright.config.ts",
    "templates/web/package.json"
  ],

  "site": {
    "repo": "Rin0107/wakuwaku-site",
    "url": "https://wakuwaku-site.Rin0107.workers.dev"
  }
}
