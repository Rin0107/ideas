{
  "owner": "Rin0107",
  "main_checkout": "~/src/okuos/repos/ideas",
  "apps_dir": "~/src/wakuwaku",
  "runtime_dir": "~/.local/state/wakuwaku",
  "state_checkout": "~/.local/state/wakuwaku/factory",
  "ideas_dir": "ideas_wakuwaku",

  "ticks_per_day": 96,
  "steps_per_run": 4,
  "max_ticks_mvp": 3,
  "max_ticks_iteration": 2,
  "max_iterations": 2,
  "max_attempts_per_issue": 3,
  "max_open_issues": 8,
  "max_mvp_issues": 3,
  "max_parallel": 2,
  "max_wip": 4,
  "focus": ["00503-yume-nikki", "00504-yofukashi-seiza", "00505-ippyou-kudasai", "00506-kanarazu-hitori"],
  "v4": {"enabled": true, "min_tasks": 20, "task_attempts": 2, "check_timeout_seconds": 600},
  "lock_ttl_minutes": 240,
  "max_consecutive_failures": 3,

  "run_hours": [],
  "max_tokens_per_day": 5000000,
  "limits": {
    "file": "~/.local/state/wakuwaku/rate-limits.json",
    "five_hour_max_pct": 70,
    "seven_day_max_pct": 85,
    "max_age_minutes": 180
  },
  "reviewers": ["sre"],

  "intake_every_days": 7,
  "retro_every_days": 7,
  "min_untried_ideas": 30,

  "patrol_every_days": 0,
  "patrol_min_ticks": 5,
  "max_proposals": 3,

  "select": {
    "candidates": 15,
    "min_free": 3,
    "min_light": 3
  },
  "evaluate": {
    "ship_min_wakuwaku": 4,
    "ship_min_quality": 3,
    "iterate_min_wakuwaku": 3
  },

  "allowed_services": ["github", "cloudflare-free", "github-releases"],
  "deny_packages": ["@supabase/supabase-js", "firebase", "@sentry/browser", "posthog-js", "mixpanel-browser", "@vercel/analytics", "openai", "@anthropic-ai/sdk", "@google/generative-ai", "stripe", "@aws-sdk/client-bedrock-runtime"],
  "protected_paths": [
    "factory.json",
    ".claude/",
    "cmd/",
    "internal/",
    "go.mod",
    "harness/TICK.md",
    "harness/PLAN.md",
    "harness/rubric.md",
    ".github/workflows/",
    "docs/DESIGN.md",
    "docs/DESIGN-v3.md",
    "docs/DESIGN-v4.md",
    "harness/reviewers/",
    "docs/ROLES.md",
    "templates/web/.github/",
    "templates/web/scripts/",
    "templates/web/src/worker/security.ts",
    "templates/web/wk.json",
    "templates/go-cli/scripts/",
    "templates/go-cli/wk.json",
    "templates/go-cli/.github/",
    "templates/site/",
    "templates/web/vitest.config.ts",
    "templates/web/stryker.config.json",
    "templates/web/spec/README.md",
    "templates/go-cli/Makefile",
    "templates/go-cli/spec/README.md",
    "docs/TESTING.md",
    "scripts/",
    "spec/",
    "templates/web/playwright.config.ts",
    "templates/web/package.json",
    "templates/web-db/"
  ],

  "reviewable_paths": [
    "harness/TICK.md",
    "harness/PLAN.md",
    "docs/DESIGN-v4.md",
    "harness/rubric.md",
    "docs/DESIGN.md",
    "docs/DESIGN-v3.md",
    "docs/ROLES.md",
    "docs/TESTING.md",
    "templates/web/.github/",
    "templates/web/scripts/",
    "templates/web/src/worker/security.ts",
    "templates/web/vitest.config.ts",
    "templates/web/stryker.config.json",
    "templates/web/spec/README.md",
    "templates/web/playwright.config.ts",
    "templates/web/package.json",
    "templates/go-cli/scripts/",
    "templates/go-cli/.github/",
    "templates/go-cli/Makefile",
