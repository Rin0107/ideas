{
  "name": "{{NAME}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0 && prettier --check src tests scripts *.config.ts",
    "format": "prettier --write src tests scripts *.config.ts",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "guards": "node scripts/deps-guard.mjs && node scripts/data-guard.mjs && node scripts/egress-guard.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run guards",
    "fuzz": "vitest run --testNamePattern fuzz",
    "mutate": "node scripts/mutate.mjs",
    "formal": "sh scripts/formal.sh"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true
  }
}
