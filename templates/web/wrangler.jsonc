{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{NAME}}",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": false,
}
